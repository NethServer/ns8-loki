#
# Resume the insights collector after a restore.
#
# Unit enablement is not module state, so without this step a restored node
# comes back with the collector configured but never running.
#
# The tail cursor is deliberately not restored: a node coming back should
# follow the log from now, not replay everything since the backup.
#

import os
import subprocess
import sys

if not os.getenv('INSIGHTS_SERVER_URL'):
    sys.exit(0)

subprocess.run(["systemctl", "--user", "enable", "--now", "insights-collector.service"],
               stdout=sys.stderr,
               stderr=sys.stderr,
               text=True,
               check=True)
