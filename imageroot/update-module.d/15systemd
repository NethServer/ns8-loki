set -e

# Redirect any output to the journal (stderr)
exec 1>&2

# Best-effort teardown of the previous generation for dev nodes that
# installed the branch build. That generation was never released, so no
# ANOMALY_* environment migration is warranted.
systemctl --user disable --now anomaly-detector.timer 2>/dev/null || :

# Pick up unit files added by this update (insights-collector.service/.timer)
systemctl --user daemon-reload
